# Necessary environment variables required for Akari to run
VITE_API_URL=https://api.akarimanga.dpdns.org

# Better Auth
BETTER_AUTH_SECRET= # Secret key for better-auth (generate with `openssl rand -base64 32`)
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Resend (server-only transactional email for Better Auth)
RESEND_API_KEY= # Resend API key; never prefix with VITE_
RESEND_FROM_EMAIL=Akari <no-reply@your-verified-domain.example> # Replace with an address on a Resend-verified domain; onboarding@resend.dev is test-only

# Database (for better-auth)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=postgres

# Optional environment variables
API_URL=https://api.akarimanga.dpdns.org # Used for server-side requests, defaults to VITE_API_URL if not set
VITE_HOST=your_website_host_here # e.g., akari.mydomain.com. Used for metadata
VITE_ANI_CLIENT_ID=your_ani_client_id_here
VITE_MAL_CLIENT_ID=your_mal_client_id_here
VITE_PLAUSIBLE_ENDPOINT=your_plausible_endpoint_here # eg https://plausible.yourdomain.com/api/event

VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here # used for web push notifications

# Debug variables
VITE_SIMULATE_SAFE_AREA_INSETS=0 # 1 to enable, 0 to disable, disabled by default